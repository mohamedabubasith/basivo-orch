{# Bulletproof-ish CTA button. Anchor-with-padding, because <button> and most
   CSS box models are unsupported in Outlook. #}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
  <tr>
    <td style="border-radius:8px;background:#111827;">
      <a href="{{ action_url }}"
         style="display:inline-block;padding:12px 24px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;">
        {{ label }}
      </a>
    </td>
  </tr>
</table>
<p style="font-size:12px;color:#6b7280;line-height:1.5;margin:0;">
  If the button does not work, paste this into your browser:<br />
  <span style="word-break:break-all;color:#374151;">{{ action_url }}</span>
</p>
