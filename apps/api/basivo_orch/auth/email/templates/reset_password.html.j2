{% extends "_base.html.j2" %}
{% block content %}
  <p style="margin:0 0 12px;">We received a request to reset your password.</p>
  {% with label = "Reset password" %}{% include "_button.html.j2" %}{% endwith %}
  <p style="margin:20px 0 0;font-size:13px;color:#6b7280;">
    This link expires in {{ expires_minutes }} minutes and can be used once.
  </p>
{% endblock %}
{% block footer %}
  If you did not request a password reset, ignore this email — your password is unchanged.
  Someone may have entered your address by mistake.
{% endblock %}
