# Where the API lives. Must match the API's PUBLIC_BASE_URL, and the API's
# CORS_ORIGINS must list this app's own origin.
#
# In production these should share a registrable domain (api.example.com and
# app.example.com) with COOKIE_DOMAIN=.example.com set on the API — otherwise
# the session cookie is host-only and never reaches the API from the SPA.
VITE_API_URL=http://localhost:8000
