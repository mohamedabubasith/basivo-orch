# Two hostnames, one image.
#
#   {$LANDING_ADDRESS}  orch.basivo.in      the marketing page
#   {$CONSOLE_ADDRESS}  console.basivo.in   login, dashboard, builder, API
#
# Caddy fetches and renews both TLS certificates itself over ACME. Nothing to
# configure beyond the hostnames, and nothing to remember to renew — which is
# the whole reason this is Caddy and not nginx plus certbot plus a cron job.
{
	email {$ACME_EMAIL}
}

# --- shared pieces ---------------------------------------------------------

# The API is proxied on BOTH hosts, deliberately. The app is built with an
# empty VITE_API_URL so it calls relative URLs, which means the browser only
# ever sees one origin: the session cookie is first-party and CORS never enters
# the deployment. That property only holds if whichever host served the page
# can also answer its API calls.
(api_proxy) {
	@api {
		# Both forms of every prefix. Caddy's `/orgs/*` matches `/orgs/x` but
		# *not* `/orgs` itself, so listing and creating — the collection
		# endpoints — would fall through to the static file server and answer
		# 405 to a POST. Nothing in development catches this: the Vite dev
		# server routes by origin, not by path.
		# `/p` and `/s` are the App Builder: the tokened preview the console
		# frames, and the published site a customer sends to anyone. Leaving
		# them out sent both to the static file server, which answered with
		# the console's own index.html, and the preview pane showed "refused
		# to connect" because that page is served X-Frame-Options DENY.
		path /auth /auth/* /users /users/* /orgs /orgs/* /api /api/* /flows /flows/* /hooks /hooks/* /billing /billing/* /p /p/* /s /s/* /health /config
	}
	handle @api {
		reverse_proxy api:8000 {
			# Streaming, not buffering. Run events are Server-Sent Events; with
			# the default buffering a client would receive the whole run at once
			# when it finished, which is exactly what the streaming endpoint
			# exists to avoid.
			flush_interval -1
		}
	}
}

# ORDER IS LOAD-BEARING. Caddy evaluates `handle` blocks in the order written,
# and they are mutually exclusive: the first matching block wins and no later
# one is consulted. So this snippet must be imported BEFORE api_proxy —
# `/auth/verify` matches `/auth/*`, and with the proxy first a confirmation link
# reached the API, which only serves POST there and answered 405 Method Not
# Allowed to everyone clicking a link in their email.
(spa_auth_pages) {
	# `/auth/*` is contested. The API serves POST /auth/verify and
	# POST /auth/reset-password, and the API *also* mails users a link to
	# `{FRONTEND_BASE_URL}/auth/verify?token=…` — a page, not an endpoint, at
	# the same path. Proxying all of /auth to the API would hand someone
	# clicking a confirmation link a lump of JSON.
	#
	# Method plus path separates them: a browser navigation is a GET, the
	# client's call is a POST. Note this deliberately does not divert the
	# API's own GET routes (/auth/csrf, /auth/sso/providers, the SSO
	# callbacks) — only these two exact paths.
	@spa_auth_pages {
		method GET
		path /auth/verify /auth/reset-password
	}
	handle @spa_auth_pages {
		rewrite * /index.html
		file_server
	}
}

# Imported LAST: a catch-all `handle` swallows everything that reached it, so
# anything after this is dead configuration.
(spa_files) {
	# Everything else is the single-page app. try_files sends unknown paths to
	# index.html so a deep link like /app/security survives a hard refresh
	# instead of 404ing.
	#
	# CACHING IS LOAD-BEARING HERE, and its absence is invisible until the day
	# you deploy and are told the site did not change. With no Cache-Control,
	# a browser applies its own heuristic, usually a tenth of the age of the
	# file, and keeps serving the index.html it already has. That file is the
	# only thing naming the current bundle, so a stale copy pins the whole
	# application to the previous release for hours.
	#
	# So: the entry points are revalidated on every visit, and the hashed
	# assets they point at are cached for a year. Vite puts a content hash in
	# every asset name, so a new build is a new name and there is nothing to
	# invalidate.
	@hashed path /assets/*
	handle @hashed {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

(security_headers) {
	header {
		# The API sets its own headers on API responses; these cover the static
		# app, which Caddy serves without the API ever being involved.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Framing is decided per path rather than for the whole host. A built app
	# is MEANT to be framed: that is the preview beside the chat. The API
	# sends those responses their own Content-Security-Policy with
	# frame-ancestors and a sandbox, which is the modern control and a
	# stricter one; adding X-Frame-Options DENY on top of it only breaks the
	# preview. Everything else on this host still refuses to be framed.
	@not_an_app not path /p /p/* /s /s/*
	header @not_an_app X-Frame-Options "DENY"
	log {
		output stdout
		format console
	}
}

# --- console.basivo.in: the product ---------------------------------------

{$CONSOLE_ADDRESS} {
	encode zstd gzip
	import spa_auth_pages
	import api_proxy
	import spa_files
	import security_headers
}

# --- orch.basivo.in: the landing page -------------------------------------

{$LANDING_ADDRESS} {
	encode zstd gzip

	# The same bundle is served here, so the marketing page's "Log in" link
	# would otherwise open the app on this hostname — a second origin holding
	# its own session cookie, and a user who bookmarks the wrong one. One
	# redirect keeps exactly one home for the product.
	#
	# 308, not `permanent` (301): a browser turns a redirected POST into a GET
	# on 301 and 302. The app's own fetches are relative, so a form submitted
	# from a page rendered on this host POSTs here — and as a 301 that arrived
	# at the console as a GET, which the API answers with 405 Method Not
	# Allowed. 308 preserves the method.
	#
	# `/auth/*` is deliberately NOT in this list. Those are API endpoints, not
	# pages, and they are proxied below on both hosts; redirecting them was the
	# other half of the same 405.
	@console_routes path /login /register /two-factor /forgot-password /confirm-email /app /app/*
	redir @console_routes {$CONSOLE_SCHEME}://{$CONSOLE_ADDRESS}{uri} 308

	import spa_auth_pages
	import api_proxy
	import spa_files
	import security_headers
}
