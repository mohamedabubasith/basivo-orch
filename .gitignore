# --- database dumps ---
# ./deploy.sh backup writes here. A dump contains every user's email address
# and password hash — it is the single most sensitive artefact this repo can
# produce, and exactly the kind of file that gets committed by a reflexive
# `git add -A`.
backups/
*.sql
*.sql.gz

# --- secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- node ---
node_modules/
.vite/
apps/web/dist/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# --- editors / os ---
.DS_Store
.idea/
.vscode/
*.swp

# --- ai assistants / editors ---
# CLAUDE.md is the contributor guide, not a personal file: it is where the
# contracts that bite live, and a rule nobody can read is a rule that gets
# broken. Same for the shared skills. Everything else under .claude/ is one
# developer's own settings and stays out.
.claude/*
!.claude/skills/
AGENTS.md
AGENT.md
# Except the one we ship: the App Builder's template carries the rules every
# coding agent reads inside a generated project. That is product source, not
# somebody's local assistant file.
!apps/api/basivo_orch/appbuilder/template/AGENTS.md
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md

# --- generated ---
apps/api/basivo_orch/auth/**/__pycache__/
.qa/run/
.qa/secrets.env
