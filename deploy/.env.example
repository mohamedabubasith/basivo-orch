# Copy to deploy/.env and fill in. `./deploy/server.sh bootstrap` does the copy
# and generates the two secrets for you.
#
# chmod 600 — this file holds the key that encrypts every stored provider
# credential.

# --- identity --------------------------------------------------------------
# Both hostnames must have an A record pointing at this server before the first
# deploy: Caddy asks Let's Encrypt for a certificate on startup, and a failed
# challenge is rate-limited (five per hostname per week).
CONSOLE_ADDRESS=console.basivo.in
LANDING_ADDRESS=orch.basivo.in
ACME_EMAIL=you@example.com

# --- secrets ---------------------------------------------------------------
# Generated by bootstrap. SECRET_KEY signs sessions AND derives the key that
# encrypts saved API keys, so changing it makes every stored credential
# undecryptable. Back it up somewhere that is not this server.
SECRET_KEY=generate-with-openssl-rand-base64-48
POSTGRES_PASSWORD=generate-me

# --- application -----------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# Where the API sends people: confirmation links, password resets, SSO
# returns. The console, never the landing page.
FRONTEND_BASE_URL=https://console.basivo.in
# Both hosts serve the app and both proxy the API, so same-origin requests
# need no CORS at all — this is belt and braces for anything cross-host.
CORS_ORIGINS=https://console.basivo.in,https://orch.basivo.in

# --- email -----------------------------------------------------------------
# Confirmation and password-reset mail goes through a webhook you own — see
# docs/email-webhook.md and deploy/configure-email.sh. Without this, nobody can
# confirm an account.
EMAIL_PROVIDER=webhook
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM=no-reply@basivo.in
EMAIL_FROM_NAME=Basivo

# --- optional --------------------------------------------------------------
# http only for a local run without certificates. Leave as https in production.
# CONSOLE_SCHEME=https
#
# The branch the server mirrors. Override for a staging box.
# BASIVO_BRANCH=main
